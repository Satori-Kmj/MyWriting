{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/mywriting-root.ts",
    "src/tool-logger.ts",
    "src/save-story-artifact.ts",
    "src/commit-story-draft.ts",
    "src/commit-story-update.ts",
    "src/mywriting-tool-filter.ts",
    "tests/**/*.ts"
  ]
}
